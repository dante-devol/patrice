// Patrice — Prisma schema (Slice 1).
//
// Conventions (docs/slices/00-overview.md):
//   - UUIDv7 PKs (PostgreSQL 18 `uuidv7()` default; see migration).
//   - timestamptz everywhere, UTC.
//   - Single-org: no tenant column. Org-wide settings are the one `system_settings` row.
//   - lifecycle_state + retired_at on core entities; FKs to core data ON DELETE RESTRICT.
//   - Some structures (citext columns, the partial bootstrap unique index, the
//     singleton CHECK) are hand-applied in the SQL migration — Prisma can't express them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LifecycleState {
  active
  deactivated
  retired
}

enum AuthProvider {
  password
  google
  discord
}

enum AuthMethod {
  password
  google
  discord
}

enum GrantEffect {
  permit
  forbid
}

enum ScopeKind {
  global
  own
  own_division
  own_team
  specific_division
  specific_team
  role
  /// Wherever the (unit) role is assigned. The only scope a unit role's grants take.
  assigned
}

/// `org` roles are held org-wide; `unit` roles are only ever assigned at a division
/// or team, and their grants apply only there.
enum RoleKind {
  org
  unit
}

enum UserRoleSource {
  patrice
  integration
}

enum AuthTokenKind {
  email_verification
  password_reset
  email_change
}

enum ActivitySource {
  patrice
  integration
  system
}

enum QuestionType {
  detail_text
  multiline
  text
  numeric
  dropdown
  radio
  attachment
}

/// A task's rolled-up status, derived from facts (completion, slots, submissions) by
/// one pure function and stored for filtering. Always set.
enum StatusCache {
  open
  claimed
  review
  revising
  approved
}

/// A submission's per-version review state (Slice 5). The lifecycle min-rule rolls
/// these up into a task's `status_cache`. `rejected` submissions are excluded from
/// the roll-up (set aside, no resubmit); a `revising` submission invites a resubmit
/// (a new row with the next `submission_no`).
enum SubmissionState {
  review
  revising
  approved
  rejected
  /// The task was completed while this submission was outstanding.
  not_required
}

/// Where a task's questions came from.
enum TemplateOrigin {
  library
  custom
}

enum AttachmentKind {
  image
  text
  audio
  model
  other
}

enum IntegrationProvider {
  discord
}

enum IntegrationStatus {
  active
  broken
}

/// What happens to the roles and memberships an integration granted when the thing
/// that granted them goes away: kept as native grants, or revoked.
enum GrantDisposition {
  keep
  revoke
}

enum SyncDirection {
  inbound
  outbound
  bidirectional
}

/// Live Discord Gateway socket state for a connection, persisted by the worker so
/// the api role (and admins) can see it. `degraded` = socket down past backoff, the
/// Reconcile Floor has tightened to 30min (api/CONTEXT.md "Reconcile Floor").
enum GatewayState {
  down
  connecting
  connected
  degraded
}

/// Where a connection sits in its sync cycle, for admin visibility. `queued` = a
/// pg-boss job is scheduled (debounce window or manual); `running` = the adapter is
/// mid-reconcile. Distinct from IntegrationStatus, which is the health verdict.
enum SyncState {
  idle
  queued
  running
}

/// Org-wide settings: exactly one row (id = 1, CHECK-enforced in the migration).
/// `config_version` is the Cedar projection cache key; bump it whenever policy text
/// changes. Secrets never live here (see `Secret`).
model SystemSettings {
  id                          Int      @id @default(1)
  orgName                     String   @default("Patrice") @map("org_name")
  configVersion               BigInt   @default(0) @map("config_version")
  requireVerifiedEmailToLogIn Boolean  @default(false) @map("require_verified_email_to_log_in")
  selfReviewAllowed           Boolean  @default(false) @map("self_review_allowed")
  anonymizeLabel              Boolean  @default(false) @map("anonymize_label")
  sessionAbsoluteDays         Int      @default(30) @map("session_absolute_days")
  sessionIdleDays             Int      @default(7) @map("session_idle_days")
  gracePeriodHours            Int      @default(24) @map("grace_period_hours")
  requireDiscordLink          Boolean  @default(false) @map("require_discord_link")
  discordClientId             String?  @map("discord_client_id")
  /// The seeded Member role, pre-assigned on new invitations (null if deleted).
  memberRoleId                String?  @map("member_role_id") @db.Uuid
  memberRoleSeeded            Boolean  @default(false) @map("member_role_seeded")
  projectLeadSeeded           Boolean  @default(false) @map("project_lead_seeded")
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberRole Role? @relation(fields: [memberRoleId], references: [id], onDelete: SetNull)

  @@map("system_settings")
}

/// An encrypted secret, one row per purpose (e.g. `discord_oauth_client_secret`).
/// `ciphertext` is an opaque handle from the secret cipher; it is never returned by
/// any read endpoint.
model Secret {
  purpose    String   @id
  ciphertext String
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("secret")
}

model Division {
  id                   String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name                 String
  defaultOpenings      Int            @default(1) @map("default_openings")
  openingsLocked       Boolean        @default(false) @map("openings_locked")
  restrictClaims       Boolean        @default(false) @map("restrict_claims")
  /// Any requester may write their own questions for a task in this division.
  allowCustomTemplates Boolean        @default(false) @map("allow_custom_templates")
  lifecycleState       LifecycleState @default(active) @map("lifecycle_state")
  retiredAt            DateTime?      @map("retired_at") @db.Timestamptz(6)
  version              Int            @default(0)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// The division's template library; at most one is the default (partial unique index).
  requestTemplates RequestTemplate[]
  tasks            Task[]
  teams            Team[]
  memberships      Membership[]
  scopedGrants     Grant[]
  groupMappings    ExternalGroupMapping[]
  unitRoles        UnitRoleAssignment[]

  @@map("division")
}

/// A team belongs to exactly one division. Team membership doesn't imply division
/// membership: both are explicit `membership` rows.
model Team {
  id             String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  divisionId     String         @map("division_id") @db.Uuid
  name           String
  restrictClaims Boolean        @default(false) @map("restrict_claims")
  lifecycleState LifecycleState @default(active) @map("lifecycle_state")
  retiredAt      DateTime?      @map("retired_at") @db.Timestamptz(6)
  version        Int            @default(0)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  division      Division               @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  tasks         Task[]
  memberships   Membership[]
  scopedGrants  Grant[]
  groupMappings ExternalGroupMapping[]
  unitRoles     UnitRoleAssignment[]

  @@index([divisionId])
  @@map("team")
}

model AppUser {
  id                     String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email                  String?        @db.Text // ALTERed to citext in migration
  displayName            String         @map("display_name")
  createdViaInvitationId String?        @map("created_via_invitation_id") @db.Uuid
  lifecycleState         LifecycleState @default(active) @map("lifecycle_state")
  deactivatedAt          DateTime?      @map("deactivated_at") @db.Timestamptz(6)
  retiredAt              DateTime?      @map("retired_at") @db.Timestamptz(6)
  version                Int            @default(0)
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  identities         UserIdentity[]
  sessions           Session[]
  userRoles          UserRole[]
  authTokens         AuthToken[]
  invitationUses     InvitationUse[]
  requestedTasks     Task[]
  completedTasks     Task[]               @relation("TaskCompleter")
  unitRoles          UnitRoleAssignment[]
  taskClaimants      TaskClaimant[]
  submissions        Submission[]
  messages           Message[]
  attachments        Attachment[]
  notifications      Notification[]
  externalIdentities ExternalIdentity[]
  oauthFlows         OAuthFlow[]
  memberships        Membership[]

  @@unique([email])
  @@map("app_user")
}

model UserIdentity {
  id              String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  provider        AuthProvider
  providerSubject String?      @map("provider_subject")
  passwordHash    String?      @map("password_hash")
  verifiedAt      DateTime?    @map("verified_at") @db.Timestamptz(6)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user AppUser @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, providerSubject])
  @@unique([userId, provider])
  @@map("user_identity")
}

model Session {
  id                String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId            String     @map("user_id") @db.Uuid
  tokenHash         String     @unique @map("token_hash")
  authMethod        AuthMethod @map("auth_method")
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt        DateTime   @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime   @map("absolute_expires_at") @db.Timestamptz(6)
  idleExpiresAt     DateTime   @map("idle_expires_at") @db.Timestamptz(6)
  revokedAt         DateTime?  @map("revoked_at") @db.Timestamptz(6)
  ip                String?    @db.Inet
  userAgent         String?    @map("user_agent")

  user AppUser @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("session")
}

model Invitation {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  email        String?   @db.Text // ALTERed to citext in migration
  passcodeHash String?   @map("passcode_hash")
  maxUses      Int       @default(1) @map("max_uses")
  useCount     Int       @default(0) @map("use_count")
  createdBy    String?   @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)

  uses  InvitationUse[]
  roles InvitationRole[]

  @@map("invitation")
}

model InvitationUse {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  invitationId  String   @map("invitation_id") @db.Uuid
  createdUserId String   @map("created_user_id") @db.Uuid
  usedAt        DateTime @default(now()) @map("used_at") @db.Timestamptz(6)

  invitation  Invitation @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  createdUser AppUser    @relation(fields: [createdUserId], references: [id], onDelete: Restrict)

  @@index([invitationId])
  @@map("invitation_use")
}

model AuthToken {
  id         String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  kind       AuthTokenKind
  tokenHash  String        @unique @map("token_hash")
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime      @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime?     @map("consumed_at") @db.Timestamptz(6)
  /// email_change only: the address that becomes the user's email once verified.
  newEmail   String?       @map("new_email") @db.Text // ALTERed to citext in migration

  user AppUser @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("auth_token")
}

/// One in-progress OAuth sign-in, register or link flow. The `state` sent to the
/// provider and the browser's nonce cookie are both stored hashed; the callback must
/// present both, and consuming the flow deletes it (login-CSRF and replay defence).
model OAuthFlow {
  id              String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  stateHash       String       @unique @map("state_hash")
  nonceHash       String       @map("nonce_hash")
  provider        AuthProvider
  intent          String
  userId          String?      @map("user_id") @db.Uuid
  inviteTokenHash String?      @map("invite_token_hash")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt       DateTime     @map("expires_at") @db.Timestamptz(6)

  user AppUser? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("oauth_flow")
}

model Role {
  id                String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name              String
  kind              RoleKind       @default(org)
  /// Unit roles only: whether someone appointing through a unit role may assign it.
  assignableByLeads Boolean        @default(false) @map("assignable_by_leads")
  lifecycleState    LifecycleState @default(active) @map("lifecycle_state")
  retiredAt         DateTime?      @map("retired_at") @db.Timestamptz(6)
  version           Int            @default(0)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  userRoles       UserRole[]
  grants          Grant[]
  groupMappings   ExternalGroupMapping[]
  memberRoleOf    SystemSettings[]
  scopedGrants    Grant[]                @relation("GrantScopeRole")
  invitations     InvitationRole[]
  unitAssignments UnitRoleAssignment[]

  @@map("role")
}

/// A unit role held by a user **at** a division or team (exactly one; CHECK). Its
/// grants (scope `assigned`) apply there; a division assignment also covers the
/// division's teams.
model UnitRoleAssignment {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  divisionId String?  @map("division_id") @db.Uuid
  teamId     String?  @map("team_id") @db.Uuid
  grantedBy  String?  @map("granted_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  division Division? @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  team     Team?     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([roleId])
  @@index([divisionId])
  @@index([teamId])
  @@map("unit_role_assignment")
}

/// A user belongs to exactly one of a division or a team (CHECK-enforced). Membership
/// grants no authority by itself: it feeds the `own_division` / `own_team` scopes and
/// claim restrictions. `source` records whether Patrice or an integration made it.
model Membership {
  id                 String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId             String         @map("user_id") @db.Uuid
  divisionId         String?        @map("division_id") @db.Uuid
  teamId             String?        @map("team_id") @db.Uuid
  source             UserRoleSource @default(patrice)
  sourceConnectionId String?        @map("source_connection_id") @db.Uuid
  grantedBy          String?        @map("granted_by") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  user     AppUser   @relation(fields: [userId], references: [id], onDelete: Restrict)
  division Division? @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  team     Team?     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([divisionId])
  @@index([teamId])
  @@map("membership")
}

model UserRole {
  id                 String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId             String         @map("user_id") @db.Uuid
  roleId             String         @map("role_id") @db.Uuid
  source             UserRoleSource @default(patrice)
  sourceConnectionId String?        @map("source_connection_id") @db.Uuid
  grantedBy          String?        @map("granted_by") @db.Uuid
  grantedAt          DateTime       @default(now()) @map("granted_at") @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  user AppUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  role Role    @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_role")
}

model Grant {
  id              String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  roleId          String      @map("role_id") @db.Uuid
  action          String
  effect          GrantEffect @default(permit)
  scopeKind       ScopeKind   @map("scope_kind")
  scopeDivisionId String?     @map("scope_division_id") @db.Uuid
  scopeTeamId     String?     @map("scope_team_id") @db.Uuid
  scopeRoleId     String?     @map("scope_role_id") @db.Uuid
  version         Int         @default(0)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  role          Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  scopeDivision Division? @relation(fields: [scopeDivisionId], references: [id], onDelete: Cascade)
  scopeTeam     Team?     @relation(fields: [scopeTeamId], references: [id], onDelete: Cascade)
  scopeRole     Role?     @relation("GrantScopeRole", fields: [scopeRoleId], references: [id], onDelete: Cascade)

  @@index([roleId])
  @@map("grant")
}

model Activity {
  id                 String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  actorUserId        String?        @map("actor_user_id") @db.Uuid
  subjectType        String         @map("subject_type")
  subjectId          String         @map("subject_id") @db.Uuid
  verb               String
  payload            Json
  source             ActivitySource
  sourceConnectionId String?        @map("source_connection_id") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([subjectType, subjectId, createdAt])
  @@index([createdAt])
  @@map("activity")
}

/// A library template belonging to a division. The requester picks one when making
/// a request, and the task takes a snapshot of its questions. Hard-deleted with an
/// audit row; tasks keep their snapshots.
model RequestTemplate {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  divisionId  String   @map("division_id") @db.Uuid
  name        String   @db.Text // ALTERed to citext in migration
  description String   @default("") @db.Text
  isDefault   Boolean  @default(false) @map("is_default")
  version     Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  division  Division                  @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  questions RequestTemplateQuestion[]
  tasks     Task[]

  @@unique([divisionId, name])
  @@map("request_template")
}

/// One typed prompt in a library template. `ordinal` orders the set; `constraints`
/// is the per-type bag (range, options, file types, char limits), validated at the
/// API boundary. Ids are stable across edits (questions are diffed by id).
model RequestTemplateQuestion {
  id                String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  requestTemplateId String       @map("request_template_id") @db.Uuid
  ordinal           Int
  type              QuestionType
  prompt            String
  required          Boolean      @default(false)
  constraints       Json         @default("{}")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  requestTemplate RequestTemplate @relation(fields: [requestTemplateId], references: [id], onDelete: Cascade)

  @@unique([requestTemplateId, ordinal])
  @@index([requestTemplateId])
  @@map("request_template_question")
}

/// A question in a task's own snapshot. Answers reference these, never a library
/// question, so editing or deleting a library template can't break a submission.
model TaskQuestion {
  id               String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  taskId           String       @map("task_id") @db.Uuid
  ordinal          Int
  type             QuestionType
  prompt           String
  required         Boolean      @default(false)
  constraints      Json         @default("{}")
  /// The library question this was copied from (provenance only, no FK).
  sourceQuestionId String?      @map("source_question_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  task    Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@unique([taskId, ordinal])
  @@map("task_question")
}

/// A unit of work, created in a division (optionally a team) with its own snapshot of
/// questions, taken from a library template or written by the requester. Completion is
/// a fact (`completed_at`); `status_cache` is derived from facts and slots. Metadata
/// edits go through PATCH; authority and structure changes through named actions.
model Task {
  id               String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name             String
  description      String         @default("") @db.Text
  divisionId       String         @map("division_id") @db.Uuid
  teamId           String?        @map("team_id") @db.Uuid
  requesterUserId  String         @map("requester_user_id") @db.Uuid
  openings         Int            @default(1)
  claimsClosed     Boolean        @default(false) @map("claims_closed")
  statusCache      StatusCache    @map("status_cache")
  sourceTemplateId String?        @map("source_template_id") @db.Uuid
  templateOrigin   TemplateOrigin @default(library) @map("template_origin")
  completedAt      DateTime?      @map("completed_at") @db.Timestamptz(6)
  completedBy      String?        @map("completed_by") @db.Uuid
  lifecycleState   LifecycleState @default(active) @map("lifecycle_state")
  retiredAt        DateTime?      @map("retired_at") @db.Timestamptz(6)
  version          Int            @default(0)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  division       Division         @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  team           Team?            @relation(fields: [teamId], references: [id], onDelete: Restrict)
  requester      AppUser          @relation(fields: [requesterUserId], references: [id], onDelete: Restrict)
  completer      AppUser?         @relation("TaskCompleter", fields: [completedBy], references: [id], onDelete: Restrict)
  sourceTemplate RequestTemplate? @relation(fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  questions      TaskQuestion[]
  attachments    Attachment[]
  claimants      TaskClaimant[]
  submissions    Submission[]
  messages       Message[]
  events         DomainEvent[]

  @@index([divisionId])
  @@index([teamId])
  @@index([statusCache])
  @@index([requesterUserId])
  @@map("task")
}

/// A claimant slot on a task (Slice 4.2). A user occupies a slot from `joined_at`
/// until `left_at` (NULL = active). UNIQUE(task_id,user_id) keeps a user to at most
/// one slot per task; re-claiming after leaving reactivates the same row. Eligibility
/// to claim is decided in Cedar (`task:assign @ own_as_claimant`), never here.
model TaskClaimant {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  taskId       String    @map("task_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  joinedAt     DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  hasSubmitted Boolean   @default(false) @map("has_submitted")
  leftAt       DateTime? @map("left_at") @db.Timestamptz(6)

  task Task    @relation(fields: [taskId], references: [id], onDelete: Restrict)
  user AppUser @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
  @@map("task_claimant")
}

/// A message on a task's thread (Slice 4.3). `comment` messages are user-authored
/// (markdown, optional attachments); senderless `system` messages are emitted for
/// claim/leave/requester-change events. Threads are **one level deep**: a reply sets
/// `parent_message_id` to a TOP-LEVEL message — a DB trigger + app guard reject a
/// reply-to-reply. `submission_id` is a bare column until its FK lands in Slice 5.
model Message {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  taskId          String    @map("task_id") @db.Uuid
  senderUserId    String?   @map("sender_user_id") @db.Uuid
  parentMessageId String?   @map("parent_message_id") @db.Uuid
  submissionId    String?   @map("submission_id") @db.Uuid
  body            String    @db.Text
  /// Set when a deleted message is kept as a marker because it has replies.
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)
  editedAt        DateTime? @map("edited_at") @db.Timestamptz(6)
  version         Int       @default(0)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  task        Task         @relation(fields: [taskId], references: [id], onDelete: Restrict)
  sender      AppUser?     @relation(fields: [senderUserId], references: [id], onDelete: Restrict)
  parent      Message?     @relation("MessageThread", fields: [parentMessageId], references: [id], onDelete: Restrict)
  replies     Message[]    @relation("MessageThread")
  // A system message hosting a submission's thread (Slice 5); NULL on comments and
  // on task-level audit messages (e.g. the retire-submission audit, which survives GC).
  submission  Submission?  @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  attachments Attachment[]

  @@index([taskId, createdAt])
  @@index([parentMessageId])
  @@index([submissionId])
  @@map("message")
}

/// A claimant's answers to the task's request template (Slice 5), versioned across
/// resubmissions by `submission_no` (part of identity — never changes after insert).
/// `version` is the separate optimistic-lock counter: `task:review` writes are
/// version-guarded and return 409 STALE_SUBMISSION on a lost update. `prev_submission_id`
/// chains a resubmission to the returned version it supersedes.
model Submission {
  id               String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  taskId           String          @map("task_id") @db.Uuid
  claimantUserId   String          @map("claimant_user_id") @db.Uuid
  submissionNo     Int             @map("submission_no")
  prevSubmissionId String?         @map("prev_submission_id") @db.Uuid
  state            SubmissionState @default(review)
  submittedAt      DateTime        @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedBy       String?         @map("reviewed_by") @db.Uuid
  reviewedAt       DateTime?       @map("reviewed_at") @db.Timestamptz(6)
  lifecycleState   LifecycleState  @default(active) @map("lifecycle_state")
  retiredAt        DateTime?       @map("retired_at") @db.Timestamptz(6)
  version          Int             @default(0)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  task            Task         @relation(fields: [taskId], references: [id], onDelete: Restrict)
  claimant        AppUser      @relation(fields: [claimantUserId], references: [id], onDelete: Restrict)
  prevSubmission  Submission?  @relation("SubmissionChain", fields: [prevSubmissionId], references: [id], onDelete: Restrict)
  nextSubmissions Submission[] @relation("SubmissionChain")
  answers         Answer[]
  messages        Message[]

  @@unique([taskId, claimantUserId, submissionNo])
  @@index([taskId])
  @@index([claimantUserId])
  @@map("submission")
}

/// One answer in a submission — a scalar `value` (text/number/choice, as jsonb) and/or
/// referenced attachments (via `attachment.answer_id`). Children of their submission
/// aggregate (ON DELETE CASCADE) so a hard-delete of the submission collects them.
model Answer {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  submissionId String   @map("submission_id") @db.Uuid
  questionId   String   @map("question_id") @db.Uuid
  value        Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  submission  Submission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question    TaskQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  attachments Attachment[]

  @@index([submissionId])
  @@map("answer")
}

/// An uploaded file on a task, stored via the StoragePort (S3 or local-fs). It belongs
/// to a message or an answer, never both (a CHECK); with neither it is a **pending**
/// upload, owned by its uploader until their own submit or message claims it.
/// `storage_key` locates the blob; the checksum is computed while streaming.
model Attachment {
  id             String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  taskId         String         @map("task_id") @db.Uuid
  messageId      String?        @map("message_id") @db.Uuid
  answerId       String?        @map("answer_id") @db.Uuid
  uploaderUserId String         @map("uploader_user_id") @db.Uuid
  storageKey     String         @map("storage_key") @db.Text
  filename       String
  contentType    String         @map("content_type")
  byteSize       BigInt         @map("byte_size")
  kind           AttachmentKind @default(other)
  checksum       String?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  task     Task     @relation(fields: [taskId], references: [id], onDelete: Restrict)
  message  Message? @relation(fields: [messageId], references: [id], onDelete: Restrict)
  answer   Answer?  @relation(fields: [answerId], references: [id], onDelete: Restrict)
  uploader AppUser  @relation(fields: [uploaderUserId], references: [id], onDelete: Restrict)

  @@index([taskId])
  @@index([messageId])
  @@index([answerId])
  @@map("attachment")
}

/// A per-recipient awareness row (Slice 6). One notification is inserted per
/// recipient when a domain event fires; the recipient cohort is resolved and
/// **snapshotted** into `payload` at event time (never re-resolved at delivery).
/// `event_seq` is monotonic per `(subject_type, subject_id, type)` and, with the
/// UNIQUE below, makes insertion **idempotent** — a retry carrying the same
/// `(recipient_user_id, type, subject_id, event_seq)` collides and no-ops. The
/// `payload` carries IDs + small denormalized facts only (Activity Payload
/// Discipline): never PII strings. SSE delivery rides a thin "sync" ping; the
/// durable row is always pulled from here, never from the stream.
model Notification {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  recipientUserId String    @map("recipient_user_id") @db.Uuid
  type            String
  subjectType     String    @map("subject_type")
  subjectId       String    @map("subject_id") @db.Uuid
  payload         Json      @default("{}")
  /// The event this notification projects; (event, recipient) is unique, so
  /// redelivering an event is a no-op.
  eventId         String?   @map("event_id") @db.Uuid
  readAt          DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  recipient AppUser      @relation(fields: [recipientUserId], references: [id], onDelete: Restrict)
  event     DomainEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@unique([eventId, recipientUserId])
  @@index([recipientUserId, readAt, createdAt])
  @@map("notification")
}

/// A connection to an external provider (Slice 8). `credentials_ref` is a seam
/// for provider credentials — never custodied here, auth is delegated to the
/// provider. `status` tracks live health; `lifecycle_state` tracks retirement.
model IntegrationConnection {
  id                     String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  provider               IntegrationProvider
  externalWorkspaceId    String              @map("external_workspace_id")
  displayName            String              @map("display_name")
  config                 Json                @default("{}")
  credentialsRef         String?             @map("credentials_ref")
  status                 IntegrationStatus   @default(active)
  lifecycleState         LifecycleState      @default(active) @map("lifecycle_state")
  retiredAt              DateTime?           @map("retired_at") @db.Timestamptz(6)
  // Observability (admin visibility). Gateway fields are written by the worker's
  // IntegrationGatewayService; sync fields by SyncService/DiscordAdapter. The api
  // role only reads these. `lastError` is a short operator-facing reason, never PII.
  gatewayState           GatewayState        @default(down) @map("gateway_state")
  gatewayLastConnectedAt DateTime?           @map("gateway_last_connected_at") @db.Timestamptz(6)
  gatewayLastEventAt     DateTime?           @map("gateway_last_event_at") @db.Timestamptz(6)
  syncState              SyncState           @default(idle) @map("sync_state")
  lastSyncStartedAt      DateTime?           @map("last_sync_started_at") @db.Timestamptz(6)
  lastSyncAt             DateTime?           @map("last_sync_at") @db.Timestamptz(6)
  lastSyncGranted        Int                 @default(0) @map("last_sync_granted")
  lastSyncRevoked        Int                 @default(0) @map("last_sync_revoked")
  lastError              String?             @map("last_error")
  /// Set at retire: what to do with this connection's grants when it's collected.
  retireDisposition      GrantDisposition?   @map("retire_disposition")
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  externalIds   ExternalIdentity[]
  groupMappings ExternalGroupMapping[]
  syncBaselines SyncBaseline[]

  @@unique([provider, externalWorkspaceId])
  @@map("integration_connection")
}

/// Links a Patrice user to their external provider account (Slice 8.2). This is
/// an **integration link only** — never an authentication path. `user_identity`
/// is the sole auth path. On user scrub/GC, these rows are purged first.
model ExternalIdentity {
  id                 String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  connectionId       String    @map("connection_id") @db.Uuid
  externalUserId     String    @map("external_user_id")
  externalHandle     String?   @map("external_handle")
  // Discord avatar hash from the OAuth /users/@me response (#52). Rendered via the
  // CDN URL pattern; `a_`-prefixed hashes are animated (we serve the static .png).
  externalAvatarHash String?   @map("external_avatar_hash")
  linkedAt           DateTime  @default(now()) @map("linked_at") @db.Timestamptz(6)
  lastSyncedAt       DateTime? @map("last_synced_at") @db.Timestamptz(6)

  user       AppUser               @relation(fields: [userId], references: [id], onDelete: Restrict)
  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  @@unique([connectionId, externalUserId])
  @@unique([userId, connectionId])
  @@index([userId])
  @@map("external_identity")
}

/// Maps a Patrice role to an external group (e.g. Discord role) within a
/// connection (Slice 8.3). `external_group_id` is a stable provider snowflake,
/// surviving renames. `is_broken` is set when the external group is deleted.
/// `conflict_winner` is used for cold-baseline conflict resolution (Slice E/#59).
model ExternalGroupMapping {
  id              String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Exactly one of role, division or team is the target (a CHECK).
  roleId          String?        @map("role_id") @db.Uuid
  divisionId      String?        @map("division_id") @db.Uuid
  teamId          String?        @map("team_id") @db.Uuid
  connectionId    String         @map("connection_id") @db.Uuid
  externalGroupId String         @map("external_group_id")
  syncDirection   SyncDirection  @map("sync_direction")
  isBroken        Boolean        @default(false) @map("is_broken")
  conflictWinner  ConflictWinner @default(patrice) @map("conflict_winner")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  role          Role?                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  division      Division?             @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  team          Team?                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  connection    IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  syncBaselines SyncBaseline[]

  @@unique([roleId, connectionId, externalGroupId])
  @@index([connectionId])
  @@map("external_group_mapping")
}

/// Sync baseline for bidirectional convergence (Slice E/#59).
/// A row = "this (external_user, external_group) edge was present at last convergence."
/// Absence = was absent. Every write (both sides) updates the baseline.
/// GC'd on: user scrub, mapping delete, connection GC (but retained through grace period).
model SyncBaseline {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  connectionId    String   @map("connection_id") @db.Uuid
  mappingId       String   @map("mapping_id") @db.Uuid
  externalUserId  String   @map("external_user_id")
  externalGroupId String   @map("external_group_id")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  mapping    ExternalGroupMapping  @relation(fields: [mappingId], references: [id], onDelete: Cascade)

  @@unique([connectionId, mappingId, externalUserId, externalGroupId])
  @@index([connectionId])
  @@index([mappingId])
  @@map("sync_baseline")
}

enum ConflictWinner {
  patrice
  external
}

/// One thing that happened, in a typed shape the client renders directly. Events with
/// a task are its timeline. `recipients` is the notification fan-out snapshotted when
/// the event happened; `notified_at` is set once the notifications are written.
model DomainEvent {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  type        String
  taskId      String?   @map("task_id") @db.Uuid
  actorUserId String?   @map("actor_user_id") @db.Uuid
  payload     Json      @default("{}")
  notifyType  String?   @map("notify_type")
  recipients  String[]  @default([]) @db.Uuid
  notifiedAt  DateTime? @map("notified_at") @db.Timestamptz(6)
  occurredAt  DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)

  task          Task?          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([taskId, occurredAt])
  @@map("domain_event")
}

/// The roles an invitation pre-assigns.
model InvitationRole {
  invitationId String @map("invitation_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([invitationId, roleId])
  @@map("invitation_role")
}
