// Cloudflare Workers (static assets) config for the browser demo: no Worker code, just
// the built site. `npm run deploy` in demo/ (after `npm run build`).
{
  "name": "patrice-demo",
  "compatibility_date": "2026-11-01",
  // Served at the root of its own subdomain (the app, the worker and the API all use
  // root paths). Cloudflare creates the DNS record and certificate on deploy; the
  // dante-devol.dev zone must be on the same Cloudflare account.
  "routes": [{ "pattern": "patrice.dante-devol.dev", "custom_domain": true }],
  "assets": {
    "directory": "./.build/site",
    // App routes (/login, /tasks, /divisions/…) aren't files: answer them with
    // index.html and let the Angular router take it from there.
    "not_found_handling": "single-page-application"
  }
}
